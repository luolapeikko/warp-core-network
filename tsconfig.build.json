{
	"compilerOptions": {
		"lib": ["es2021", "dom", "dom.iterable"],
		"module": "commonjs",
		"target": "es2021",
		"rootDir": "./src",
		"outDir": "./dist",
		"sourceRoot": "./src",
		"types": ["node"],
		"sourceMap": true,
		"strict": true,
		"declaration": true,
		"removeComments": false,
		"inlineSources": true,
		"inlineSourceMap": false,
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"importHelpers": true,
		"strictNullChecks": true,
		"noUnusedLocals": true
	},
	"include": ["src","test"],
	"exclude": ["node_modules", "dist"],
}
